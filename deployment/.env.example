# Copy to .env beside this file and fill in. `.env` is gitignored — this
# repository is public, and nothing below belongs in it.
#
#   cp .env.example .env && chmod 600 .env

# The gym's domain, without a scheme. Caddy issues the certificate for exactly
# this name, so the DNS A record must already point here before first boot —
# repeated ACME failures hit a Let's Encrypt rate limit.
SITE_DOMAIN=gym.example.com

# Postgres. Generate, do not invent:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# JWT signing key. HS256 over a UTF-8 key, so give it real entropy:
#   openssl rand -base64 48
# Changing it invalidates every access token in circulation — everyone is
# signed out at once. Refresh tokens are SHA-256 rows in the database and
# survive, so the SPA's interceptor recovers on its own.
JWT_SIGNING_KEY=

# Brevo. Leave both blank and the app registers LogEmailSender instead, writing
# reset links to the container log — fine for a first boot, useless to a member.
#
# Two things no code change can fix: BREVO_FROM_EMAIL must be a sender VERIFIED
# in the Brevo dashboard or every send comes back 400, and the sending domain
# needs SPF and DKIM records or Gmail files the reset mail as spam. Startup
# fails if the key is set without the address.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# The first owner account, created on boot. There is no other way in: the
# schema seeds a tenant and a branch but cannot seed a login, because the
# password hash is a versioned PBKDF2 blob that cannot be written into a .sql
# file.
#
# DELETE BOTH once you have signed in and changed the password. Seeding is
# idempotent, so removing them changes nothing except that the password stops
# sitting in a file on the server.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
